# .env do NÓ descentralizado (PAPEL=no) — copie para .env e preencha.
# Ver docs/no_descentralizado.md e docker-compose.no.yml (o compose lê TUDO daqui).
# No central nada disto é preciso: PAPEL ausente = central.

NOME_PROJETO=policia

# ---- identificação deste nó -------------------------------------------------------------
# Papel do processo: o compose já fixa PAPEL=no no serviço; esta linha é para rodar SEM
# docker (uvicorn main:app direto na estação).
PAPEL=no

# ---- o caminho de volta para casa --------------------------------------------------------
# Endereço do CENTRAL que este nó atende (é para onde o túnel NAT e o heartbeat apontam).
# Teste na MESMA máquina: http://host.docker.internal:8080
CENTRAL_URL=http://10.27.7.19:8080

# Token gerado na tela Administração → Servidores do central (o mesmo que o central guarda
# em TX_TOKEN). Única credencial do nó: valida toda chamada em /no/* e o heartbeat.
NO_TOKEN=

# Beatimentos/leituras (segundos): 60 e 600 bastam; só mexa se a WAN for muito lenta.
NO_HEARTBEAT_SEGUNDOS=60
NO_TIMEOUT_LEITURA_SEGUNDOS=600

# ---- portas -------------------------------------------------------------------------------
# Porta que o central alcança (vira TX_URL_BASE no registro do nó).
NO_PORT=8090
# Mídia direta ao navegador na LAN da delegação (HTTPS, nginx no-web; docs/no_midia_direta.md).
NO_MIDIA_PORT=8443
# Origem que pode chamar /no/midia (CORS) — em produção é o site do central.
NO_MIDIA_ORIGIN=https://policia-es.pf.gov.br

# ---- túnel NAT + jobs na estação (docs/no_descentralizado.md) -----------------------------
# 1 (padrão): o nó tenta abrir o WebSocket ao central; 0 desliga este nó.
TUNEL_NO_ATIVO=1
# Jobs de OCR/CLIP/facial (e TP_OCR_SELECAO) que a CPU desta estação puxa do central: 1
# job grande por vez é o teto honesto para uma estação de delegacia.
JOBS_NO_LIMITE=1
# Endereço interno do serviço 'tunel' no central (raramente precisa mexer).
# TUNEL_BASE_URL=http://tunel:3001

# ---- execução local -----------------------------------------------------------------------
# Um worker basta: hash/parse/importação são uma operação por arquivo e o central já
# serializa a fila dele.
API_WORKERS=1
